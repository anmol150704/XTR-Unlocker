<Application
    x:Class="DLSS_Swapper.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DLSS_Swapper">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->


                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <Color x:Key="SystemAccentColor">#6366F1</Color>
                            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#6366F1" />
                            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#818CF8" />
                            <Color x:Key="WindowCaptionBackground">Transparent</Color>
                            <Color x:Key="WindowCaptionBackgroundDisabled">Transparent</Color>
                            <Color x:Key="WindowCaptionForeground">#FFFFFF</Color>
                            <Color x:Key="WindowCaptionForegroundDisabled">#666666</Color>
                            <Color x:Key="WindowCaptionButtonBackgroundPointerOver">#1F222E</Color>

                            <Color x:Key="BackgroundLevel0">#0B0C10</Color>
                            <Color x:Key="BackgroundLevel1">#14161F</Color>
                            <Color x:Key="BackgroundLevel2">#1E212E</Color>

                            <Color x:Key="ButtonBackgroundColor">#1C1E2A</Color>
                            <Color x:Key="ButtonForegroundColor">#FFFFFF</Color>
                            <Color x:Key="ButtonHoverBackgroundColor">#272A3B</Color>
                            <Color x:Key="ButtonHoverForegroundColor">#FFFFFF</Color>
                            <Color x:Key="ButtonInactiveBackgroundColor">#151720</Color>
                            <Color x:Key="ButtonInactiveForegroundColor">#737788</Color>
                            <Color x:Key="ButtonPressedBackgroundColor">#31354A</Color>
                            <Color x:Key="ButtonPressedForegroundColor">#A5A9B8</Color>
                            <Color x:Key="InformationalIconColor">#818CF8</Color>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <Color x:Key="SystemAccentColor">#5651E5</Color>
                            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#5651E5" />
                            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#6D69F3" />
                            <Color x:Key="WindowCaptionBackground">Transparent</Color>
                            <Color x:Key="WindowCaptionBackgroundDisabled">Transparent</Color>
                            <Color x:Key="WindowCaptionForeground">#000000</Color>
                            <Color x:Key="WindowCaptionForegroundDisabled">#999999</Color>
                            <Color x:Key="WindowCaptionButtonBackgroundPointerOver">#EAEBED</Color>

                            <Color x:Key="BackgroundLevel0">#F5F6F8</Color>
                            <Color x:Key="BackgroundLevel1">#FFFFFF</Color>
                            <Color x:Key="BackgroundLevel2">#ECEEF2</Color>

                            <Color x:Key="ButtonBackgroundColor">#FFFFFF</Color>
                            <Color x:Key="ButtonForegroundColor">#000000</Color>
                            <Color x:Key="ButtonHoverBackgroundColor">#E8EAF0</Color>
                            <Color x:Key="ButtonHoverForegroundColor">#000000</Color>
                            <Color x:Key="ButtonInactiveBackgroundColor">#F5F6F8</Color>
                            <Color x:Key="ButtonInactiveForegroundColor">#9295A3</Color>
                            <Color x:Key="ButtonPressedBackgroundColor">#DFE1E8</Color>
                            <Color x:Key="ButtonPressedForegroundColor">#555866</Color>
                            <Color x:Key="InformationalIconColor">#5651E5</Color>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>

                <ResourceDictionary Source="Themes/XtrDesign.xaml" />
                <ResourceDictionary Source="Themes/FakeContentDialogStyle.xaml" />

                <ResourceDictionary>
                    <Style x:Key="ErrorFontIcon" TargetType="FontIcon">
                        <Setter Property="Glyph" Value="&#xE783;" />
                        <Setter Property="FontSize" Value="20" />
                        <Setter Property="Foreground" Value="{ThemeResource SystemErrorTextColor}" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->

            <Style TargetType="FontIcon">
                <Setter Property="FontFamily" Value ="Assets/Fonts/Segoe-Fluent-Icons.ttf#Segoe Fluent Icons"/>
            </Style>

            <Style TargetType="FontIcon" x:Name="SagoeFluentIconsFontIcon">
                <Setter Property="FontFamily" Value ="Assets/Fonts/Segoe-Fluent-Icons.ttf#Segoe Fluent Icons"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
