<Page
    x:Class="DLSS_Swapper.Pages.XtrStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:DLSS_Swapper.Pages"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource XtrBackgroundBrush}">

    <Page.Resources>
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,48" Spacing="24" MaxWidth="1160" HorizontalAlignment="Stretch">

            <!-- HEADER STUDIO BANNER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                            <Image Margin="5" Source="Assets/icon_256.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="XTR STUDIO &amp; ENGINE HUB" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource XtrDisplayFontFamily}" Foreground="{ThemeResource XtrTextBrush}" VerticalAlignment="Center" />
                        <Border Padding="8,3" CornerRadius="8" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="NATIVE ENGINE 2.4" FontSize="10" FontWeight="Bold" CharacterSpacing="70" Foreground="{ThemeResource XtrAccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Hardware Architecture Tier Diagnostics, NVIDIA NGX OTA Model Store, Global Preset &amp; Anti-Ghosting Configuration."
                               FontSize="13" Foreground="{ThemeResource XtrSecondaryTextBrush}" Margin="42,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Style="{StaticResource XtrPrimaryButtonStyle}"
                            Height="38"
                            Padding="16,0"
                            CornerRadius="12"
                            Command="{x:Bind ViewModel.TurboBoostAllGamesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="13" />
                            <TextBlock Text="Turbo Boost All Games" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- STATUS NOTICE BANNER -->
            <Border Padding="14,10" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{ThemeResource XtrSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <muxc:ProgressRing Grid.Column="2" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- SECTION 1: SYSTEM & GPU HARDWARE ARCHITECTURE TIER -->
            <Grid Padding="20" CornerRadius="18" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="PRIMARY GRAPHICS ADAPTER &amp; ARCHITECTURE TIER" FontSize="11" FontWeight="Bold" CharacterSpacing="70" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.HardwareInfo.Name, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource XtrTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Height="32" Padding="12,0" CornerRadius="10" Style="{StaticResource XtrSecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshHardwareCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                            <TextBlock Text="Rescan Hardware" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Microarchitecture -->
                    <Border Grid.Column="0" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="ARCHITECTURE" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.HardwareInfo.Architecture, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrAccentBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Optical Flow &amp; Tensor Cores" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Dedicated Memory -->
                    <Border Grid.Column="1" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="DEDICATED MEMORY" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.HardwareInfo.VramGigabytes, Mode=OneWay, FallbackValue='4.0'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}">
                                <Run Text=" GB VRAM" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.HardwareInfo.DriverVersion, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}">
                                <Run Text="Driver: " />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- HAGS & Reflex Status -->
                    <Border Grid.Column="2" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="HARDWARE SCHEDULING (HAGS)" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource XtrSuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Online &amp; Active" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrSuccessBrush}" />
                            </StackPanel>
                            <TextBlock Text="Reflex &amp; DirectSR Ready" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Optimal FG Routing -->
                    <Border Grid.Column="3" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="OPTIMAL FRAME GENERATION" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.HardwareInfo.RecommendedFgMode, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrSuccessBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Anti-Ghosting Shield Active" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- SECTION 2: NVIDIA NGX OTA MODEL STORE & DIRECTSR INTERPOSER -->
            <Border Padding="18,14" CornerRadius="16" Background="#0C1322" BorderBrush="#0284C7" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="12" Background="#0C2540" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8F1;" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="NVIDIA NGX OTA MODEL STORE" FontSize="10.5" FontWeight="Bold" CharacterSpacing="70" Foreground="#38BDF8" />
                            <Border Padding="6,2" CornerRadius="6" Background="#0F3356">
                                <TextBlock Text="{x:Bind ViewModel.NgxStoreStatus, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#7DD3FC" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.DirectSrCompatibilityStatus, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="DirectSR 1.0 Super Resolution, Streamline v2.4 Interposer, and verified DLSS 3.7+ / 3.5 / 2.5 neural model weights." FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>

                    <Button Grid.Column="2" Height="34" Padding="14,0" CornerRadius="10" Style="{StaticResource XtrSecondaryButtonStyle}" Command="{x:Bind ViewModel.SyncNgxStoreCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                            <TextBlock Text="Sync OTA Store" FontSize="11.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- SECTION 3: GLOBAL PRESET & ANTI-GHOSTING SHIELD CONFIGURATION -->
            <Grid Padding="20" CornerRadius="18" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock Text="GLOBAL PRESET &amp; ANTI-GHOSTING SHIELD" FontSize="11" FontWeight="Bold" CharacterSpacing="70" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                    <TextBlock Text="Engine-level defaults applied during batch deployment and 1-click game acceleration." FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Anti-Ghosting Shield Global Setting -->
                    <Border Grid.Row="0" Grid.Column="0" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE730;" FontSize="13" Foreground="{ThemeResource XtrAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Anti-Ghosting Shield (OptiFG)" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="Clones motion vectors and separates HUD swapchains to eliminate motion smearing." FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.GlobalAntiGhostingEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Streamline Spoofing Global Setting -->
                    <Border Grid.Row="0" Grid.Column="1" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource XtrAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Streamline RTX 40 Spoofing" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="Unlocks the native Frame Generation setting in game menus on RTX 20/30 series GPUs." FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.GlobalStreamlineSpoofingEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Neural Model Preset -->
                    <Border Grid.Row="1" Grid.Column="0" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Default DLSS Neural Model Preset" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                            <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.GlobalPresets}" SelectedItem="{x:Bind ViewModel.SelectedGlobalPreset, Mode=TwoWay}" />
                            <TextBlock Text="Preset E provides optimal ghosting elimination; Preset K/M targets ultra-low latency." FontSize="10.5" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- AI Sharpness RCAS -->
                    <Border Grid.Row="1" Grid.Column="1" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Default AI Image Sharpness (RCAS)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.GlobalRcasSharpnessLabel, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource XtrAccentBrush}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" StepFrequency="5" Value="{x:Bind ViewModel.GlobalRcasSharpness, Mode=TwoWay}" />
                            <TextBlock Text="Robust Contrast-Adaptive Sharpening applied post-upscale." FontSize="10.5" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- SECTION 4: IN-GAME ENGINE DIAGNOSTICS & HOTKEYS -->
            <Grid Padding="20" CornerRadius="18" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock Text="IN-GAME ENGINE DIAGNOSTICS &amp; HOTKEYS" FontSize="11" FontWeight="Bold" CharacterSpacing="70" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                    <TextBlock Text="Configure the low-level OptiScaler developer menu and dynamic frame generation shortcuts." FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                </StackPanel>

                <!-- Hotkey Selectors -->
                <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Dev Menu Key -->
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="In-Game Diagnostics Hotkey" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.DevMenuKeys}" SelectedItem="{x:Bind ViewModel.SelectedDevMenuKey, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                        <TextBlock Text="Toggles OptiScaler developer menu [Insert]" FontSize="10.5" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Frame Gen Toggle Key -->
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Frame Gen Toggle Hotkey" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.FgKeys}" SelectedItem="{x:Bind ViewModel.SelectedFgKey, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                        <TextBlock Text="Dynamically toggles FG on / off [End]" FontSize="10.5" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Theme Style -->
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Diagnostics Menu Theme" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.OverlayThemes}" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                        <TextBlock Text="In-game developer panel visual style" FontSize="10.5" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Hotkey Informational Note -->
                <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,10" CornerRadius="12" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ENGINE HOTKEY REFERENCE" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        <TextBlock Text="• Press the Diagnostics Hotkey in-game to inspect real-time swapchain hooks, motion vector scales, and internal scaling resolution." FontSize="11.5" Foreground="{ThemeResource XtrTextBrush}" />
                        <TextBlock Text="• Press the Frame Gen Hotkey to instantly toggle frame generation on or off without restarting your session." FontSize="11.5" Foreground="{ThemeResource XtrTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION 5: 1-CLICK BATCH ACTIONS & RECOVERY -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="18" CornerRadius="16" Background="#13261C" BorderBrush="#34C759" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="12" Background="#1D4A30" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="#34C759" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Batch Turbo Boost All Games" FontSize="14" FontWeight="Bold" Foreground="#E6FCEE" />
                            <TextBlock Text="Deploys hardware-tiered neural preset + Anti-Ghosting Shield across all games in your library." FontSize="11.5" Foreground="#A7F3D0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource XtrPrimaryButtonStyle}" Height="36" Padding="14,0" CornerRadius="10" Command="{x:Bind ViewModel.TurboBoostAllGamesCommand}" Content="Boost All" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Padding="18" CornerRadius="16" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="12" Background="{ThemeResource XtrElevatedBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="{ThemeResource XtrSecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Revert All Games to Stock" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource XtrTextBrush}" />
                            <TextBlock Text="Safely restores clean original vendor DLLs and removes bridge proxies across all games." FontSize="11.5" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource XtrSecondaryButtonStyle}" Height="36" Padding="14,0" CornerRadius="10" Command="{x:Bind ViewModel.RestoreAllGamesCommand}" Content="Restore All" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>