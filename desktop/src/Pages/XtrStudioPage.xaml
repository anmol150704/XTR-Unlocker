<Page
    x:Class="DLSS_Swapper.Pages.XtrStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:DLSS_Swapper.Pages"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource XtrBackgroundBrush}">

    <Page.Resources>
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,48" Spacing="24" MaxWidth="1160" HorizontalAlignment="Stretch">

            <!-- HEADER STUDIO BANNER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                            <Image Margin="5" Source="Assets/icon_256.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="XTR STUDIO HUB" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource XtrDisplayFontFamily}" Foreground="{ThemeResource XtrTextBrush}" VerticalAlignment="Center" />
                        <Border Padding="8,3" CornerRadius="8" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="NATIVE ENGINE 2.4" FontSize="10" FontWeight="Bold" CharacterSpacing="70" Foreground="{ThemeResource XtrAccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Active Hardware Telemetry, In-Game HUD Studio, Hotkey Remapping, and Universal Frame Generation Optimization."
                               FontSize="13" Foreground="{ThemeResource XtrSecondaryTextBrush}" Margin="42,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Style="{StaticResource XtrPrimaryButtonStyle}"
                            Height="38"
                            Padding="16,0"
                            CornerRadius="12"
                            Command="{x:Bind ViewModel.TurboBoostAllGamesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="13" />
                            <TextBlock Text="Turbo Boost All Games" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- STATUS NOTICE BANNER -->
            <Border Padding="14,10" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{ThemeResource XtrSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <muxc:ProgressRing Grid.Column="2" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- SECTION 1: HARDWARE & GPU DIAGNOSTICS CARD -->
            <Grid Padding="20" CornerRadius="18" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="PRIMARY GRAPHICS ADAPTER &amp; ARCHITECTURE" FontSize="11" FontWeight="Bold" CharacterSpacing="70" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.HardwareInfo.Name, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource XtrTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Height="32" Padding="12,0" CornerRadius="10" Style="{StaticResource XtrSecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshHardwareCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                            <TextBlock Text="Rescan Hardware" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Microarchitecture -->
                    <Border Grid.Column="0" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="ARCHITECTURE" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.HardwareInfo.Architecture, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrAccentBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Optical Flow &amp; Tensor Cores" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- VRAM & Driver -->
                    <Border Grid.Column="1" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="DEDICATED MEMORY" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.HardwareInfo.VramGigabytes, Mode=OneWay, FallbackValue='4.0'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}">
                                <Run Text=" GB VRAM" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.HardwareInfo.DriverVersion, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}">
                                <Run Text="Driver: " />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- HAGS Status -->
                    <Border Grid.Column="2" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="HARDWARE SCHEDULING (HAGS)" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource XtrSuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Online &amp; Active" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrSuccessBrush}" />
                            </StackPanel>
                            <TextBlock Text="Ultra Low Latency Pacing" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Optimal FG Routing -->
                    <Border Grid.Column="3" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="OPTIMAL FRAME GENERATION" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.HardwareInfo.RecommendedFgMode, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrSuccessBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Anti-Ghosting Shield Active" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- SECTION 2: INTERACTIVE IN-GAME HUD OVERLAY STUDIO -->
            <Grid Padding="20" CornerRadius="18" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock Text="IN-GAME HUD OVERLAY STUDIO &amp; HOTKEY REMAPPING" FontSize="11" FontWeight="Bold" CharacterSpacing="70" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                    <TextBlock Text="Customizable Apple Dark Glass HUD Overlay with Live Telemetry Simulator" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                </StackPanel>

                <!-- LIVE HUD PILL SIMULATOR CARD -->
                <Border Grid.Row="1" Margin="0,16,0,0" Padding="18" CornerRadius="16" Background="#0C1017" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="LIVE HUD TELEMETRY SIMULATOR (WHAT YOU SEE IN GAME)" FontSize="10.5" FontWeight="Bold" CharacterSpacing="70" Foreground="#818CF8" />

                        <!-- Simulated Horizontal Apple Pill -->
                        <Border HorizontalAlignment="Left"
                                Padding="16,8"
                                CornerRadius="12"
                                Background="#E60D121B"
                                BorderBrush="#4034C759"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <!-- FPS Counter -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#34C759" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.SimulatedHudFps, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#34C759" />
                                    <TextBlock Text="{x:Bind ViewModel.SimulatedHudFrametime, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Width="1" Height="14" Background="#30FFFFFF" />

                                <!-- Upscaler -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="DLSS 3.7" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" />
                                    <TextBlock Text="Quality (0.67x)" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>

                                <Border Width="1" Height="14" Background="#30FFFFFF" />

                                <!-- Frame Gen Status -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="#A7F3D0" VerticalAlignment="Center" />
                                    <TextBlock Text="FG 2.0x (FSR 3.1 Bridge)" FontSize="12" FontWeight="SemiBold" Foreground="#A7F3D0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tip: If your keyboard has no dedicated Page Up key (or requires Fn), switch your HUD Toggle hotkey to F10 below!" FontSize="11.5" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <!-- HOTKEY & THEME SELECTOR GRID -->
                <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dev Menu Key -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                        <TextBlock Text="In-Game Menu Hotkey" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.DevMenuKeys}" SelectedItem="{x:Bind ViewModel.SelectedDevMenuKey, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                    </StackPanel>

                    <!-- FPS HUD Toggle Key -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                        <TextBlock Text="FPS HUD Overlay Hotkey" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.HudKeys}" SelectedItem="{x:Bind ViewModel.SelectedHudKey, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                    </StackPanel>

                    <!-- HUD Detail Cycle Key -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                        <TextBlock Text="HUD Detail Mode Hotkey" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.CycleKeys}" SelectedItem="{x:Bind ViewModel.SelectedCycleKey, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                    </StackPanel>

                    <!-- Frame Gen Toggle Key -->
                    <StackPanel Grid.Row="0" Grid.Column="3" Spacing="6">
                        <TextBlock Text="Frame Gen Toggle Hotkey" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.FgKeys}" SelectedItem="{x:Bind ViewModel.SelectedFgKey, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                    </StackPanel>

                    <!-- HUD Position -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                        <TextBlock Text="Overlay Screen Position" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.HudPositions}" SelectedIndex="{x:Bind ViewModel.SelectedPositionIndex, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                    </StackPanel>

                    <!-- HUD Detail Level -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                        <TextBlock Text="Default Telemetry Mode" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.HudModes}" SelectedIndex="{x:Bind ViewModel.SelectedModeIndex, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                    </StackPanel>

                    <!-- Theme Style -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Spacing="6">
                        <TextBlock Text="HUD &amp; Menu Color Theme" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" ItemsSource="{x:Bind ViewModel.OverlayThemes}" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" SelectionChanged="Hotkey_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- SECTION 3: 1-CLICK BATCH ACTIONS & RECOVERY -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="18" CornerRadius="16" Background="#13261C" BorderBrush="#34C759" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="12" Background="#1D4A30" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="#34C759" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Batch Turbo Boost All Games" FontSize="14" FontWeight="Bold" Foreground="#E6FCEE" />
                            <TextBlock Text="Deploys Preset E Anti-Ghosting + Ultra Low Latency to all games in your library." FontSize="11.5" Foreground="#A7F3D0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource XtrPrimaryButtonStyle}" Height="36" Padding="14,0" CornerRadius="10" Command="{x:Bind ViewModel.TurboBoostAllGamesCommand}" Content="Boost All" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Padding="18" CornerRadius="16" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="12" Background="{ThemeResource XtrElevatedBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="{ThemeResource XtrSecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Revert All Games to Stock" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource XtrTextBrush}" />
                            <TextBlock Text="Safely restores clean original vendor DLLs and removes bridge proxies." FontSize="11.5" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource XtrSecondaryButtonStyle}" Height="36" Padding="14,0" CornerRadius="10" Command="{x:Bind ViewModel.RestoreAllGamesCommand}" Content="Restore All" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
