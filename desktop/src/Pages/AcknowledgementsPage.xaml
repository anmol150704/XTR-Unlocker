<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DLSS_Swapper.Pages.AcknowledgementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DLSS_Swapper.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:communitytoolkitcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Page.Resources>
    
    <Grid Background="{ThemeResource XtrBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,24,36,12">
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.TranslationProperties.LicencesAndAcknowledgementsText, Mode=OneWay}" TextWrapping="NoWrap" FontSize="30" FontWeight="SemiBold" CharacterSpacing="-18" Foreground="{ThemeResource XtrTextBrush}" />
                <TextBlock Text="Third-party open-source components, technologies, and runtime libraries" FontSize="13.5" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <!-- Content Grid -->
        <Grid Grid.Row="1" ColumnSpacing="20" Padding="36,8,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8"
                    CornerRadius="18"
                    Background="{ThemeResource XtrElevatedBrush}"
                    BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                    BorderThickness="1">
                <ListView ItemsSource="{x:Bind ViewModel.Acknowlegements}"
                          SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          Background="Transparent"
                          Padding="0" />
            </Border>

            <Border Grid.Column="1"
                    Padding="24"
                    CornerRadius="18"
                    Background="{ThemeResource XtrSurfaceBrush}"
                    BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <communitytoolkitcontrols:MarkdownTextBlock Visibility="{x:Bind ViewModel.SelectedItem.Notes, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"
                                                                Text="{x:Bind ViewModel.SelectedItem.Notes, FallbackValue='', Mode=OneWay}"
                                                                Config="{x:Bind ViewModel.MarkdownConfig, Mode=OneWay}" />

                        <Border Height="1" Background="{ThemeResource XtrGlassBorderBrush}" Visibility="{x:Bind ViewModel.SelectedItem.Notes, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" />

                        <TextBlock IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.SelectedItem.License, FallbackValue='', Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.SelectedItem.License, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{ThemeResource XtrSecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
