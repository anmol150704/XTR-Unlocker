<Page
    x:Class="DLSS_Swapper.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:system="using:System"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:data="using:DLSS_Swapper.Data"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    x:Name="thisPage"
    Background="{ThemeResource XtrBackgroundBrush}">

    <Page.Resources>
        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadingConverter" DesierdState="Downloading" />
        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadedConverter" DesierdState="Downloaded" />
        <converters:DLSSStateVisibilityConverter x:Key="IsNotFoundConverter" DesierdState="NotFound" />
        <converters:DLSSStateVisibilityConverter x:Key="IsLocalConverter" DesierdState="Imported" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BytesToMegaBytesConverter x:Key="BytesToMegaBytesConverter" />
        <converters:TotalBytesVisbilityConverter x:Key="TotalBytesVisbilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Apple Liquid Header -->
        <Grid Grid.Row="0" Padding="36,26,36,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Upscaler &amp; Runtime Library" TextWrapping="NoWrap" FontSize="29" FontWeight="SemiBold" CharacterSpacing="-20" Foreground="{ThemeResource XtrTextBrush}" VerticalAlignment="Center" />
                    <muxc:ProgressRing Width="16" Height="16" IsActive="True" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="Download, verify, and switch DLSS, DLSS-G, and FSR binaries" FontSize="13" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource XtrSecondaryButtonStyle}"
                        Content="{x:Bind ViewModel.TranslationProperties.ImportText, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.ImportFromLocalFilesText, Mode=OneWay}" Command="{x:Bind ViewModel.ImportCommand}" />
                            <MenuFlyoutSubItem Text="NVIDIA">
                                <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.ImportFromDriverText, Mode=OneWay}" Command="{x:Bind ViewModel.ImportFromNVIDIADriverCommand}" />
                                <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.ImportFromDownloadServerText, Mode=OneWay}" Command="{x:Bind ViewModel.ImportFromNVIDIAServerCommand}" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Style="{StaticResource XtrSecondaryButtonStyle}"
                        Content="{x:Bind ViewModel.TranslationProperties.ExportAllText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ExportAllCommand}" />

                <Button Style="{StaticResource XtrPrimaryButtonStyle}"
                        Content="{x:Bind ViewModel.TranslationProperties.DownloadLatestText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.DownloadLatestCommand}" />

                <Button Style="{StaticResource XtrSecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}">
                    <Button.Content>
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE72C;" FontSize="13" />
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="AdminInfoBar"
                 Grid.Row="1"
                 Margin="36,0,36,12"
                 IsOpen="True"
                 Severity="Warning"
                 IsClosable="False"
                 CornerRadius="14"
                 Title="{x:Bind ViewModel.TranslationProperties.WarningText, Mode=OneWay}"
                 Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                 Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="36,0">
            <SelectorBar x:Name="UpscalerSelectorBar" SelectedItem="{x:Bind ViewModel.SelectedSelectorBarItem, Mode=TwoWay}" />
        </ScrollViewer>

        <GridView Grid.Row="3" x:Name="MainGridView" Margin="28,12,28,0" SizeChanged="MainGridView_SizeChanged" ItemsSource="{x:Bind ViewModel.SelectedLibraryList, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MainGridView_ItemClick" Background="Transparent">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="8" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="16" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="data:DLLRecord">
                    <!-- Apple Liquid Frosted Card -->
                    <Border BorderThickness="1"
                            Padding="16,14"
                            Background="{ThemeResource XtrElevatedBrush}"
                            BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                            CornerRadius="16"
                            Width="260">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{x:Bind DisplayName}"
                                       HorizontalAlignment="Stretch"
                                       ToolTipService.ToolTip="{x:Bind DisplayName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource XtrTextBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Imported -->
                            <StackPanel Grid.Row="1" Visibility="{x:Bind LocalRecord, Converter={StaticResource IsLocalConverter}, Mode=OneWay}" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                                <Border Padding="8,3" CornerRadius="8" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE7B8;" FontSize="11" Foreground="{ThemeResource XtrAccentBrush}" />
                                        <TextBlock Text="Imported" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Not downloaded -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="{x:Bind LocalRecord, Converter={StaticResource IsNotFoundConverter}, Mode=OneWay}">
                                <Button ToolTipService.ToolTip="{x:Bind TranslationProperties.DownloadErrorText, Mode=OneWay}"
                                        Visibility="{x:Bind LocalRecord.HasDownloadError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.ShowDownloadErrorCommand}"
                                        CommandParameter="{x:Bind }"
                                        CornerRadius="10">
                                    <Button.Content>
                                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE783;" FontSize="12" />
                                    </Button.Content>
                                </Button>

                                <Button ToolTipService.ToolTip="{x:Bind TranslationProperties.DownloadText, Mode=OneWay}"
                                        Style="{StaticResource XtrPrimaryButtonStyle}"
                                        Padding="12,6"
                                        CornerRadius="12"
                                        Command="{Binding ViewModel.DownloadRecordCommand, ElementName=thisPage}"
                                        CommandParameter="{x:Bind }">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE896;" FontSize="11" />
                                        <TextBlock Text="Get" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Downloading -->
                            <Grid Grid.Row="1" ColumnSpacing="8" Visibility="{x:Bind LocalRecord, Converter={StaticResource IsDownloadingConverter}, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ProgressBar Grid.Row="0" Minimum="0" Maximum="100" IsIndeterminate="{x:Bind LocalRecord.FileDownloader.IsIndeterminate, Mode=OneWay}" Value="{x:Bind LocalRecord.FileDownloader.Percent, Mode=OneWay}" VerticalAlignment="Top" />

                                    <TextBlock Grid.Row="1" Margin="0,3,0,0" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" Visibility="{x:Bind LocalRecord.FileDownloader.TotalBytesToDownload, Mode=OneWay, Converter={StaticResource TotalBytesVisbilityConverter}}" Text="{x:Bind system:String.Format('{0:0.0}%', LocalRecord.FileDownloader.Percent), Mode=OneWay}" />
                                </Grid>

                                <Button Grid.Column="1"
                                        ToolTipService.ToolTip="{Binding TranslationProperties.CancelText, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.CancelDownloadRecordCommand}"
                                        CommandParameter="{x:Bind }"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <Button.Content>
                                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE711;" FontSize="11" />
                                    </Button.Content>
                                </Button>
                            </Grid>

                            <!-- Downloaded -->
                            <StackPanel Grid.Row="1" Visibility="{x:Bind LocalRecord, Converter={StaticResource IsDownloadedConverter}, Mode=OneWay}" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="Ready" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource XtrSuccessBrush}" />
                                </Border>
                                <Button ToolTipService.ToolTip="{x:Bind TranslationProperties.ExportText, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.ExportRecordCommand}"
                                        CommandParameter="{x:Bind }"
                                        CornerRadius="10">
                                    <Button.Content>
                                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xEDE1;" FontSize="12" />
                                    </Button.Content>
                                </Button>
                                <Button ToolTipService.ToolTip="{x:Bind TranslationProperties.DeleteText, Mode=OneWay}"
                                        Command="{Binding ElementName=thisPage, Path=ViewModel.DeleteRecordCommand}"
                                        CommandParameter="{x:Bind }"
                                        CornerRadius="10">
                                    <Button.Content>
                                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE74D;" FontSize="12" />
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
