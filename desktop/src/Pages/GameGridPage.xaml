<Page
    x:Class="DLSS_Swapper.Pages.GameGridPage"
    x:Name="RootGameGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:data="using:DLSS_Swapper.Data"
    xmlns:system="using:System"
    xmlns:pages="using:DLSS_Swapper.Pages"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    d:DataContext="pages:GameGridPageModel"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />
        <converters:BitmapImageUriConverter x:Key="BitmapImageUriConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" TrueValue="0.5" FalseValue="1.0" NullValue="1.0" />

        <DataTemplate x:Key="ListViewTemplate" x:DataType="pages:GameGridPageModel">
            <ListView ItemsSource="{x:Bind CurrentCollectionView, Mode=OneWay}"
                      ItemClick="GridAndListView_ItemClick"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      Padding="28,8,28,28"
                      Background="Transparent">
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="data:GameGroup">
                                <TextBlock Text="{x:Bind Name}"
                                           Margin="0,24,0,10"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind Name, Converter={StaticResource StringVisibilityConverter}}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:Game">
                        <Border Padding="12"
                                CornerRadius="13"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="62" CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="DLSS" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind CurrentDLSS.DisplayName, FallbackValue='Not detected', Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <muxc:ProgressRing Grid.Column="2" Width="18" Height="18" IsActive="True" Visibility="{x:Bind Processing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind Processing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DataTemplate>

        <DataTemplate x:Key="GridViewTemplate" x:DataType="pages:GameGridPageModel">
            <GridView x:Name="MainGridView"
                      ItemsSource="{x:Bind CurrentCollectionView, Mode=OneWay}"
                      PointerWheelChanged="MainGridView_PointerWheelChanged"
                      ManipulationMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="GridAndListView_ItemClick"
                      SelectionMode="None"
                      Padding="20,6,20,30"
                      Background="Transparent">
                <GridView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="data:GameGroup">
                                <TextBlock Text="{x:Bind Name}"
                                           Margin="2,22,0,12"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind Name, Converter={StaticResource StringVisibilityConverter}}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="7" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="16" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="data:Game">
                        <Border Width="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemWidth, Mode=OneWay}"
                                Height="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemHeight, Mode=OneWay}"
                                CornerRadius="16"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid>
                                <Border CornerRadius="16">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                                <Border VerticalAlignment="Bottom" Height="142" CornerRadius="0,0,16,16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#C9000000" Offset="0.5" />
                                            <GradientStop Color="#F0000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="12"
                                        Padding="9,5"
                                        CornerRadius="9"
                                        Background="#C51B1B22">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" Fill="#A99BFF" VerticalAlignment="Center" />
                                        <TextBlock Text="DLSS" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                                <muxc:ProgressRing Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" IsActive="True" Visibility="{x:Bind Processing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                <StackPanel VerticalAlignment="Bottom" Padding="15,8,15,15" Spacing="5">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextWrapping="WrapWholeWords"
                                               MaxLines="2" />
                                    <TextBlock FontSize="12" Foreground="#E6FFFFFF" Visibility="{x:Bind Processing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}">
                                        <Run Text="{x:Bind CurrentDLSS.DisplayName, FallbackValue='No DLSS detected', Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </DataTemplate>

        <usercontrols:ListGridViewTemplateSelector x:Key="TemplateSelector"
                                                   ListViewTemplate="{StaticResource ListViewTemplate}"
                                                   GridVeiwTemplate="{StaticResource GridViewTemplate}" />
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="32,28,32,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.TranslationProperties.PageTitle, Mode=OneWay}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           CharacterSpacing="-18" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Your installed games and upscaler files"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <muxc:ProgressRing Width="16" Height="16" IsActive="True" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="12,7"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7" Height="7" Fill="#31B56A" VerticalAlignment="Center" />
                    <TextBlock Text="Library ready" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Padding="32,0,32,18" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="9" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Height="38"
                         Padding="12,0"
                         CornerRadius="10"
                         AcceptsReturn="False"
                         IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                         PlaceholderText="Search games"
                         TextChanged="{x:Bind ViewModel.SearchForGameEvent}" />
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="{x:Bind SearchBox.Text, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                        Click="ClearSearchBox_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshGamesButtonCommand}"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        ToolTipService.ToolTip="Scan your game launchers again">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}"
                        Content="{x:Bind ViewModel.TranslationProperties.AddGameText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.AddManualGameButtonCommand}"
                        IsEnabled="{x:Bind ViewModel.CanAddGameAndChangeView, Mode=OneWay}" />
                <Button Content="More"
                        IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.BulkSwapText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSelectionModeCommand}" />
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.FilterText, Mode=OneWay}" Command="{x:Bind ViewModel.FilterGamesButtonCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Grid view" Command="{x:Bind ViewModel.ChangeGameGridViewCommand}" CommandParameter="{x:Bind pages:GameGridViewType.GridView}" />
                            <MenuFlyoutItem Text="List view" Command="{x:Bind ViewModel.ChangeGameGridViewCommand}" CommandParameter="{x:Bind pages:GameGridViewType.ListView}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ContentControl x:Name="MainContentControl"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{x:Bind ViewModel, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource TemplateSelector}" />

            <InfoBar x:Name="AdminInfoBar"
                     Margin="24"
                     VerticalAlignment="Bottom"
                     IsOpen="True"
                     Severity="Warning"
                     IsClosable="False"
                     Title="Running as administrator"
                     Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                     Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24"
                    Padding="14,10"
                    CornerRadius="14"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.SelectedGamesCountText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="{x:Bind ViewModel.TranslationProperties.SelectAllText, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAllVisibleCommand}" />
                    <Button Content="{x:Bind ViewModel.TranslationProperties.SelectNoneText, Mode=OneWay}" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.TranslationProperties.SelectDllsText, Mode=OneWay}" Command="{x:Bind ViewModel.ApplyBatchDllCommand}" />
                    <Button Content="{x:Bind ViewModel.TranslationProperties.CloseText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSelectionModeCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
