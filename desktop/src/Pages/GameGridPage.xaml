<Page
    x:Class="DLSS_Swapper.Pages.GameGridPage"
    x:Name="RootGameGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:data="using:DLSS_Swapper.Data"
    xmlns:system="using:System"
    xmlns:pages="using:DLSS_Swapper.Pages"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    d:DataContext="pages:GameGridPageModel"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Background="{ThemeResource XtrBackgroundBrush}">

    <Page.Resources>
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />
        <converters:BitmapImageUriConverter x:Key="BitmapImageUriConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" TrueValue="0.5" FalseValue="1.0" NullValue="1.0" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:NullToInverseVisibilityConverter x:Key="NullToInverseVisibilityConverter" />

        <DataTemplate x:Key="ListViewTemplate" x:DataType="pages:GameGridPageModel">
            <ListView ItemsSource="{x:Bind CurrentCollectionView, Mode=OneWay}"
                      ItemClick="GridAndListView_ItemClick"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      Padding="32,10,32,32"
                      Background="Transparent">
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="data:GameGroup">
                                <TextBlock Text="{x:Bind Name}"
                                           Margin="0,20,0,10"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource XtrSecondaryTextBrush}"
                                           Visibility="{x:Bind Name, Converter={StaticResource StringVisibilityConverter}}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:Game">
                        <Border Padding="14"
                                CornerRadius="16"
                                BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource XtrSurfaceBrush}"
                                Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="68" CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Prominent DLSS Version in List View -->
                                        <Border Padding="8,2" CornerRadius="8" Background="{ThemeResource XtrGlassBadgeBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrAccentBrush}">
                                                <Run Text="{x:Bind DlssVersionLabel, FallbackValue='DLSS not detected', Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{x:Bind IntegrationStatus, Mode=OneWay}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource XtrSecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right side Frame Gen indicator pill -->
                                <Border Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Padding="10,4"
                                        CornerRadius="12"
                                        Background="#183D24"
                                        BorderBrush="#2ECC71"
                                        BorderThickness="1"
                                        Visibility="{x:Bind RuntimeManifest, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="6" Height="6" Fill="#34C759" VerticalAlignment="Center" />
                                        <TextBlock Text="FG ACTIVE" FontSize="10.5" FontWeight="Bold" Foreground="#E6FCEE" />
                                    </StackPanel>
                                </Border>

                                <muxc:ProgressRing Grid.Column="3" Width="18" Height="18" IsActive="True" Visibility="{x:Bind Processing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource XtrSecondaryTextBrush}" VerticalAlignment="Center" Visibility="{x:Bind Processing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DataTemplate>

        <DataTemplate x:Key="GridViewTemplate" x:DataType="pages:GameGridPageModel">
            <GridView x:Name="MainGridView"
                      ItemsSource="{x:Bind CurrentCollectionView, Mode=OneWay}"
                      PointerWheelChanged="MainGridView_PointerWheelChanged"
                      ManipulationMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="GridAndListView_ItemClick"
                      SelectionMode="None"
                      Padding="28,10,28,36"
                      Background="Transparent">
                <GridView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="data:GameGroup">
                                <TextBlock Text="{x:Bind Name}"
                                           Margin="4,22,0,12"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource XtrSecondaryTextBrush}"
                                           Visibility="{x:Bind Name, Converter={StaticResource StringVisibilityConverter}}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="9" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="18" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="data:Game">
                        <!-- Apple Liquid Squircle Card -->
                        <Border Width="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemWidth, Mode=OneWay}"
                                Height="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemHeight, Mode=OneWay}"
                                CornerRadius="18"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                                Background="{ThemeResource XtrSurfaceBrush}"
                                Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                            <Grid>
                                <!-- Poster Artwork -->
                                <Border CornerRadius="18">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Apple Silky Depth Gradient Scrim -->
                                <Border VerticalAlignment="Bottom" Height="140" CornerRadius="0,0,18,18">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#A6090A0E" Offset="0.45" />
                                            <GradientStop Color="#F208090C" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Top-Left Floating Liquid Glass Badge: VISIBLE DLSS VERSION & GENERATION -->
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="11"
                                        Padding="10,5"
                                        CornerRadius="12"
                                        Background="#CC161824"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#818CF8" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind DlssBadgeText, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </StackPanel>
                                </Border>

                                <!-- Top-Right Floating Liquid Badge: FRAME GENERATION ACTIVE / READY -->
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="11"
                                        Padding="9,5"
                                        CornerRadius="12"
                                        Background="#DD153720"
                                        BorderBrush="#6034C759"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Frame Generation runtime active"
                                        Visibility="{x:Bind RuntimeManifest, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#34C759" VerticalAlignment="Center" />
                                        <TextBlock Text="FG ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#E6FCEE" />
                                    </StackPanel>
                                </Border>

                                <muxc:ProgressRing Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="11,46,11,0" IsActive="True" Visibility="{x:Bind Processing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                                <!-- Bottom Poster Info & DLSS Version Details -->
                                <StackPanel VerticalAlignment="Bottom" Padding="15,10,15,15" Spacing="4">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               FontSize="16.5"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextWrapping="WrapWholeWords"
                                               MaxLines="2" />

                                    <!-- Explicit DLSS Version Line -->
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#C7D2FE" Visibility="{x:Bind Processing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}">
                                        <Run Text="{x:Bind DlssVersionLabel, FallbackValue='DLSS not detected', Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- Integration Engine Status -->
                                    <TextBlock Text="{x:Bind IntegrationStatus, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </DataTemplate>

        <usercontrols:ListGridViewTemplateSelector x:Key="TemplateSelector"
                                                   ListViewTemplate="{StaticResource ListViewTemplate}"
                                                   GridVeiwTemplate="{StaticResource GridViewTemplate}" />
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Apple macOS Style Hero Header -->
        <Grid Grid.Row="0" Padding="36,28,36,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Game Library"
                           FontSize="29"
                           FontWeight="SemiBold"
                           CharacterSpacing="-20"
                           Foreground="{ThemeResource XtrTextBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Native DLSS upscaling, ray reconstruction &amp; frame generation bridge"
                               FontSize="13"
                               Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                    <muxc:ProgressRing Width="16" Height="16" IsActive="True" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Apple Liquid Status Pill -->
            <Border Grid.Column="1"
                    Padding="14,8"
                    CornerRadius="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource XtrSurfaceBrush}"
                    BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource XtrSuccessBrush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                    <muxc:ProgressRing Width="13" Height="13" IsActive="True" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock Text="Engine Ready - FSR 3.1 Swapchain Active" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock Text="Scanning Launchers..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Apple Liquid Toolbar Bar: Spotlight Search + Pill Buttons -->
        <Grid Grid.Row="1" Padding="36,0,36,18" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Spotlight Search Pill -->
            <Grid ColumnSpacing="9" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="220" MaxWidth="360" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource XtrSecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Height="38"
                         Padding="14,0"
                         CornerRadius="19"
                         Background="{ThemeResource XtrSurfaceBrush}"
                         BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                         BorderThickness="1"
                         AcceptsReturn="False"
                         IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                         PlaceholderText="Search games by title..."
                         TextChanged="{x:Bind ViewModel.SearchForGameEvent}" />
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="{x:Bind SearchBox.Text, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                        Click="ClearSearchBox_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <!-- Action Pill Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource XtrSecondaryButtonStyle}"
                        Content="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshGamesButtonCommand}"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        ToolTipService.ToolTip="Rescan your game launchers">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Style="{StaticResource XtrPrimaryButtonStyle}"
                        Content="{x:Bind ViewModel.TranslationProperties.AddGameText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.AddManualGameButtonCommand}"
                        IsEnabled="{x:Bind ViewModel.CanAddGameAndChangeView, Mode=OneWay}" />
                <Button Style="{StaticResource XtrSecondaryButtonStyle}"
                        Content="View Options"
                        IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.BulkSwapText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSelectionModeCommand}" />
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.FilterText, Mode=OneWay}" Command="{x:Bind ViewModel.FilterGamesButtonCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Grid View" Command="{x:Bind ViewModel.ChangeGameGridViewCommand}" CommandParameter="{x:Bind pages:GameGridViewType.GridView}" />
                            <MenuFlyoutItem Text="List View" Command="{x:Bind ViewModel.ChangeGameGridViewCommand}" CommandParameter="{x:Bind pages:GameGridViewType.ListView}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ContentControl x:Name="MainContentControl"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{x:Bind ViewModel, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource TemplateSelector}" />

            <InfoBar x:Name="AdminInfoBar"
                     Margin="24"
                     VerticalAlignment="Bottom"
                     IsOpen="True"
                     Severity="Warning"
                     IsClosable="False"
                     CornerRadius="14"
                     Title="Running as administrator"
                     Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                     Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24"
                    Padding="16,10"
                    CornerRadius="18"
                    BorderThickness="1"
                    Background="{ThemeResource XtrSurfaceBrush}"
                    BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                    Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.SelectedGamesCountText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Style="{StaticResource XtrSecondaryButtonStyle}" Content="{x:Bind ViewModel.TranslationProperties.SelectAllText, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAllVisibleCommand}" />
                    <Button Style="{StaticResource XtrSecondaryButtonStyle}" Content="{x:Bind ViewModel.TranslationProperties.SelectNoneText, Mode=OneWay}" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
                    <Button Style="{StaticResource XtrPrimaryButtonStyle}" Content="{x:Bind ViewModel.TranslationProperties.SelectDllsText, Mode=OneWay}" Command="{x:Bind ViewModel.ApplyBatchDllCommand}" />
                    <Button Style="{StaticResource XtrSecondaryButtonStyle}" Content="{x:Bind ViewModel.TranslationProperties.CloseText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSelectionModeCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
