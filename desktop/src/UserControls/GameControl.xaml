<?xml version="1.0" encoding="utf-8"?>
<usercontrols:FakeContentDialog
    x:Class="DLSS_Swapper.UserControls.GameControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:converters="using:DLSS_Swapper.Converters"
    xmlns:helpers="using:DLSS_Swapper.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:data="using:DLSS_Swapper.Data"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=usercontrols:GameControlModel, IsDesignTimeCreatable=True}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <usercontrols:FakeContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1060</x:Double>
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToInvisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:BoolToObjectConverter x:Key="FavouriteTextConverter" TrueValue="{Binding TranslationProperties.FavouritedText, Mode=OneWay}" FalseValue="{Binding TranslationProperties.ClickToFavouriteText, Mode=OneWay}" />
        <ct_converters:BoolToObjectConverter x:Key="FavouriteGlyphConverter" TrueValue="&#xE735;" FalseValue="&#xE734;" />
        <ct_converters:EmptyObjectToObjectConverter x:Key="NullObjectToBoolConverter" NotEmptyValue="True" EmptyValue="False" />
        <ct_converters:EmptyCollectionToObjectConverter x:Key="EmptyCollectionToObjectConverter" NotEmptyValue="True" EmptyValue="False" />

        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadingConverter" DesierdState="Downloading" />
        <converters:DLSSStateVisibilityConverter x:Key="IsDownloadedConverter" DesierdState="Downloaded" />
        <converters:DLSSStateVisibilityConverter x:Key="IsNotFoundConverter" DesierdState="NotFound" />
        <converters:DLSSStateVisibilityConverter x:Key="IsImportedConverter" DesierdState="Imported" />
        <converters:BitmapImageUriConverter x:Key="BitmapImageUriConverter" />
        <converters:NullableBoolToObjectConverter x:Key="HideGameTextConverter" NullValue="{Binding TranslationProperties.ClickToHideText, Mode=OneWay}" FalseValue="{Binding TranslationProperties.ClickToHideText, Mode=OneWay}" TrueValue="{Binding TranslationProperties.HiddenText, Mode=OneWay}" />
        <converters:NullableBoolToObjectConverter x:Key="HideGameGlyphConverter" NullValue="&#xE7B3;" FalseValue="&#xE7B3;" TrueValue="&#xED1A;" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:NullToInverseVisibilityConverter x:Key="NullToInverseVisibilityConverter" />

        <Style x:Key="XtrQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource XtrSecondaryButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource XtrElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource XtrGlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <ControlTemplate x:Key="LeftButtonsControlTemplate" TargetType="ContentControl">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" XYFocusKeyboardNavigation="Enabled" Padding="{ThemeResource ContentDialogPadding}" Background="{TemplateBinding Background}" Spacing="8">
                <Button Command="{Binding LaunchCommand}" ToolTipService.ToolTip="{Binding TranslationProperties.LaunchText, Mode=OneWay}" CornerRadius="12">
                    <Button.Content>
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE768;" />
                    </Button.Content>
                </Button>
                <Button ToolTipService.ToolTip="{Binding TranslationProperties.NotesText, Mode=OneWay}" Command="{Binding EditNotesCommand}" CornerRadius="12">
                    <Button.Content>
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE70B;" />
                    </Button.Content>
                </Button>
                <Button ToolTipService.ToolTip="{Binding TranslationProperties.HistoryText, Mode=OneWay}" Command="{Binding ViewHistoryCommand}" CornerRadius="12">
                    <Button.Content>
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE81C;" />
                    </Button.Content>
                </Button>
                <Button Command="{Binding FavouriteCommand}" ToolTipService.ToolTip="{Binding Game.IsFavourite, Converter={StaticResource FavouriteTextConverter}}" CornerRadius="12">
                    <Button.Content>
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="{Binding Game.IsFavourite, Converter={StaticResource FavouriteGlyphConverter}}" />
                    </Button.Content>
                </Button>
                <Button Command="{Binding ReloadGameCommand}" ToolTipService.ToolTip="{Binding TranslationProperties.ReloadText, Mode=OneWay}" CornerRadius="12">
                    <Button.Content>
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE72C;" />
                    </Button.Content>
                </Button>
                <Button Command="{Binding ShowHideGameCommand}" ToolTipService.ToolTip="{Binding Game.IsHidden, Mode=OneWay, Converter={StaticResource HideGameTextConverter}}" CornerRadius="12">
                    <Button.Content>
                        <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="{Binding Game.IsHidden, Mode=OneWay, Converter={StaticResource HideGameGlyphConverter}}" />
                    </Button.Content>
                </Button>
            </StackPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="RightButtonsControlTemplate" TargetType="ContentControl">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" XYFocusKeyboardNavigation="Enabled" Padding="{ThemeResource ContentDialogPadding}" Background="{TemplateBinding Background}" Spacing="8">
                <Button Content="{Binding TranslationProperties.RemoveText, Mode=OneWay}" Visibility="{Binding IsManuallyAdded, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding RemoveCommand}" CornerRadius="14" />
                <Button x:Name="CloseButton" IsTabStop="False" Content="{Binding TranslationProperties.CloseText, Mode=OneWay}" Style="{StaticResource XtrSecondaryButtonStyle}" ElementSoundMode="FocusOnly" Command="{Binding CloseCommand}" KeyboardAcceleratorPlacementMode="Hidden">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" Modifiers="None" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </ControlTemplate>

        <Style x:Key="InformationalFontIcon" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE946;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource InformationalIconColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </usercontrols:FakeContentDialog.Resources>

    <usercontrols:FakeContentDialog.Content>
        <Grid Grid.Row="0" ColumnSpacing="28" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Poster Artwork & Profile Controls -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="10">
                <Grid Width="220" Height="330" CornerRadius="18" BorderThickness="1" ColumnSpacing="0" RowSpacing="0" Margin="0" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}">
                    <Border BorderThickness="0" Width="220" Height="330" FlowDirection="LeftToRight" CornerRadius="18">
                        <Border.RenderTransform>
                            <CompositeTransform ScaleX="1" />
                        </Border.RenderTransform>
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill">
                                <ImageBrush.ImageSource>
                                    <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind ViewModel.Game.CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}" />
                                </ImageBrush.ImageSource>
                            </ImageBrush>
                        </Border.Background>
                    </Border>

                    <Border VerticalAlignment="Bottom" Height="110" CornerRadius="0,0,18,18" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#E608090C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Padding="16,10,16,16" Spacing="4" IsHitTestVisible="False">
                        <TextBlock Text="NATIVE PROFILE" FontSize="10" CharacterSpacing="95" FontWeight="Bold" Foreground="#D8D4FF" />
                        <TextBlock Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="WrapWholeWords" MaxLines="2" />
                    </StackPanel>

                    <Button HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch" Command="{x:Bind ViewModel.AddCoverImageCommand}" AllowDrop="True" DragEnter="CoverButton_DragEnter" DragOver="CoverButton_DragOver" Drop="CoverButton_Drop" />
                </Grid>
                <Button Content="{x:Bind ViewModel.TranslationProperties.AddCustomCoverText, Mode=OneWay}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AddCoverImageCommand}" Style="{StaticResource XtrQuietButtonStyle}" />
            </StackPanel>

            <!-- Right Column: Game Details, DLSS & Frame Gen Engine Controls -->
            <Grid Grid.Column="1">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Spacing="6">
                    <InfoBar
                        Visibility="{x:Bind ViewModel.Game.IsReadyToPlay, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Severity="Warning"
                        IsOpen="True"
                        IsClosable="False"
                        CornerRadius="14"
                        Message="{x:Bind ViewModel.TranslationProperties.GameNotReadyToPlayStateText, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind ViewModel.TranslationProperties.HelpText, Mode=OneWay}" Command="{x:Bind ViewModel.ReadyToPlayStateMoreInformationCommand}" HorizontalAlignment="Right" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- Game Name -->
                    <TextBlock Text="{x:Bind ViewModel.TranslationProperties.NameText, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" VerticalAlignment="Stretch" CornerRadius="12" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" Text="{x:Bind ViewModel.GameTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsManuallyAdded, Converter={StaticResource BoolNegationConverter}}" />
                        <Button Grid.Column="1" VerticalAlignment="Stretch" CornerRadius="12" ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.SaveText, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsManuallyAdded, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{x:Bind ViewModel.GameTitleHasChanged, Mode=OneWay}" Command="{x:Bind ViewModel.SaveTitleCommand}">
                            <Button.Content>
                                <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE74E;" />
                            </Button.Content>
                        </Button>
                    </Grid>

                    <!-- Game Install Path -->
                    <TextBlock Text="{x:Bind ViewModel.TranslationProperties.InstallPathText, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource XtrSecondaryTextBrush}" Padding="0,4,0,0" />
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" CornerRadius="12" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" Text="{x:Bind ViewModel.Game.InstallPath}" VerticalAlignment="Stretch" />
                        <Button Grid.Column="1" CornerRadius="12" ToolTipService.ToolTip="{x:Bind ViewModel.TranslationProperties.OpenFolderText, Mode=OneWay}" VerticalAlignment="Stretch" Command="{x:Bind ViewModel.OpenInstallPathCommand}">
                            <Button.Content>
                                <FontIcon Style="{StaticResource SagoeFluentIconsFontIcon}" Glyph="&#xE8A7;" />
                            </Button.Content>
                        </Button>
                    </Grid>

                    <!-- Apple Liquid Glass Hero Card: Native DLSS & Frame Generation Engine -->
                    <Grid Padding="18" Margin="0,12,0,0" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1" CornerRadius="20" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header & Status Pill -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Native DLSS &amp; Frame Generation Control Center" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PrimaryActionExplanationText, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource XtrSecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Top" Padding="12,5" CornerRadius="12" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                                <TextBlock Text="{x:Bind ViewModel.RuntimeStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource XtrAccentBrush}" />
                            </Border>
                        </Grid>

                        <!-- PROMINENT DLSS VERSION & FRAME GEN STATUS ROW -->
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- DLSS Version Tile -->
                            <Border Grid.Column="0" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" Fill="#818CF8" VerticalAlignment="Center" />
                                        <TextBlock Text="ACTIVE DLSS VERSION" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource XtrAccentBrush}">
                                        <Run Text="{x:Bind ViewModel.Game.DlssVersionLabel, FallbackValue='DLSS not detected', Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}">
                                        <Run Text="Game engine using " />
                                        <Run Text="{x:Bind ViewModel.Game.DlssGenerationText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Frame Generation Tile -->
                            <Border Grid.Column="1" Padding="14,12" CornerRadius="14" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource XtrSuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="FRAME GENERATION ENGINE" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.FrameGenerationStatusText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource XtrSuccessBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Native Streamline DLSS-G / FSR 3.1" FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- DLSS GENERATION QUICK SELECTOR BAR -->
                        <Border Grid.Row="2" Padding="14,10" CornerRadius="14" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="QUICK DLSS GENERATION SWITCHER" FontSize="10" FontWeight="Bold" CharacterSpacing="60" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="DLSS 3.7+ (Latest)" Style="{StaticResource XtrPillButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.QuickSwapDlss37Command}" ToolTipService.ToolTip="Switch immediately to latest DLSS 3.7+ DLL" />
                                    <Button Grid.Column="1" Content="DLSS 3.5 (Ray Recon)" Style="{StaticResource XtrPillButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.QuickSwapDlss35Command}" ToolTipService.ToolTip="Switch to DLSS 3.5 with Ray Reconstruction support" />
                                    <Button Grid.Column="2" Content="DLSS 2.5 (Stable)" Style="{StaticResource XtrPillButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.QuickSwapDlss25Command}" ToolTipService.ToolTip="Switch to classic pure DLSS 2.5 DLL" />
                                    <Button Grid.Column="3" Content="More Versions..." Style="{StaticResource XtrPillButtonStyle}" Command="{x:Bind ViewModel.OpenDlssPickerCommand}" ToolTipService.ToolTip="Open complete DLSS library picker" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- DUAL FRAME GENERATION MODES (NATIVE DLSS-G VS UNIVERSAL FSR BRIDGE) -->
                        <Grid Grid.Row="3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Content="âš¡ Native DLSS 3 Hardware FG"
                                Style="{StaticResource XtrPrimaryButtonStyle}"
                                Command="{x:Bind ViewModel.EnableNativeDlssGCommand}"
                                Visibility="{x:Bind ViewModel.Game.RuntimeManifest, Converter={StaticResource NullToInverseVisibilityConverter}, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Height="42"
                                CornerRadius="18"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                ToolTipService.ToolTip="Uses pure NVIDIA nvngx_dlssg.dll hardware optical flow acceleration directly without FSR" />

                            <Button
                                Grid.Column="1"
                                Content="âœ¦ Universal FG Bridge (FSR 3.1)"
                                Style="{StaticResource XtrPrimaryButtonStyle}"
                                Command="{x:Bind ViewModel.EnableFrameGenerationCommand}"
                                Visibility="{x:Bind ViewModel.Game.RuntimeManifest, Converter={StaticResource NullToInverseVisibilityConverter}, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Height="42"
                                CornerRadius="18"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                ToolTipService.ToolTip="Translates DLSS-G calls to FSR 3.1 swapchain with Anti-Ghosting shield for RTX 20/30/AMD/Intel" />

                            <Button
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Content="â†º Restore original game files"
                                Style="{StaticResource XtrSecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.RestoreRuntimeCommand}"
                                Visibility="{x:Bind ViewModel.Game.RuntimeManifest, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Height="42"
                                CornerRadius="18"
                                FontSize="13.5" />
                        </Grid>

                        <!-- ANTI-GHOSTING SHIELD & LIVE ENGINE CONTROLS -->
                        <Border
                            Grid.Row="4"
                            Padding="14"
                            Background="{ThemeResource XtrSurfaceBrush}"
                            BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Visibility="{x:Bind ViewModel.Game.RuntimeManifest, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource XtrSuccessBrush}" />
                                        <TextBlock Text="ANTI-GHOSTING SHIELD &amp; LIVE DETECTION" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Refresh Detection"
                                        FontSize="11"
                                        Height="28"
                                        Padding="12,0"
                                        CornerRadius="10"
                                        Command="{x:Bind ViewModel.RefreshDiagnosticsCommand}" />
                                </Grid>

                                <TextBlock Text="{x:Bind ViewModel.RuntimeHealthSummaryText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" TextWrapping="Wrap" />

                                <!-- Anti-Ghosting Toggle -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="ðŸ›¡ï¸ Anti-Ghosting Shield (HUD Separation &amp; Buffer Cloning)" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                                        <TextBlock Text="Eliminates HUD smearing, subtitle ghosting, and double-image edge trails." FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AntiGhostingShieldEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                                </Grid>

                                <!-- In-Game HUD Overlay Toggle -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="ðŸ“Š In-Game FPS &amp; Frame Gen Overlay [Page Up]" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                                        <TextBlock Text="Shows real-time frame rates and generated frame interpolation delta." FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.InGameHudOverlayEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Streamline Spoofing Toggle -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="ðŸ”“ Streamline RTX 40 Spoofing" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                                        <TextBlock Text="Unlocks the native DLSS Frame Generation toggle in game menus on RTX 20/30 cards." FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StreamlineSpoofingEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                                </Grid>
                                <!-- In-Game Developer Menu Toggle [Insert] -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="ðŸ› ï¸ Native ImGui Developer Menu [Insert]" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                                        <TextBlock Text="Displays the underlying C++ backend developer menu for low-level engine debugging (disabled by default for clean presentation)." FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.InGameDevMenuEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Visibility="Collapsed">
                                </Grid>

                                <Border Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="IN-GAME OVERLAY HOTKEYS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                                        <TextBlock Text="• [Insert] key — Open / close in-game OptiScaler settings menu" FontSize="11.5" Foreground="{ThemeResource XtrTextBrush}" />
                                        <TextBlock Text="• [Page Up] key — Toggle real-time FPS &amp; Frame Generation HUD" FontSize="11.5" Foreground="{ThemeResource XtrTextBrush}" />
                                        <TextBlock Text="• [End] key — Toggle Frame Generation on / off dynamically" FontSize="11.5" Foreground="{ThemeResource XtrTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Progressive Disclosure: Advanced Settings -->
                        <Expander Grid.Row="5" Header="Advanced runtime options" IsExpanded="False" HorizontalAlignment="Stretch" CornerRadius="12">
                            <StackPanel Spacing="10" Padding="0,8,0,0">
                                <TextBlock Text="Proxy selection and custom packages are optional. XTR manages these automatically by default." FontSize="11" Foreground="{ThemeResource XtrSecondaryTextBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        Grid.Column="0"
                                        ItemsSource="{x:Bind ViewModel.RuntimeProxyNames}"
                                        SelectedItem="{x:Bind ViewModel.SelectedRuntimeProxy, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="10"
                                        Visibility="{x:Bind ViewModel.Game.RuntimeManifest, Converter={StaticResource NullToInverseVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.Game.RuntimeManifest.ProxyFileName, Mode=OneWay, TargetNullValue=Default proxy}"
