<Window
    x:Class="DLSS_Swapper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:pages="using:DLSS_Swapper.Pages"
    Title="XTR Unlocker"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" MinWidth="720" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,12,0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="18" Height="18" VerticalAlignment="Center" Source="Assets/icon_256.png" />
            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="XTR Unlocker"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Grid>

        <muxc:NavigationView x:Name="MainNavigationView"
                             Grid.Row="1"
                             PaneDisplayMode="Left"
                             IsPaneOpen="True"
                             IsPaneToggleButtonVisible="False"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="True"
                             OpenPaneLength="224"
                             CompactPaneLength="64"
                             SelectionFollowsFocus="Disabled"
                             ItemInvoked="MainNavigationView_ItemInvoked"
                             Loaded="MainNavigationView_Loaded"
                             Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <muxc:NavigationView.PaneHeader>
                <Grid Padding="18,12,12,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="11" Background="#6155D9">
                        <Image Margin="7" Source="Assets/icon_256.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="XTR Unlocker" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="GAME LIBRARY" FontSize="9" CharacterSpacing="110" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </muxc:NavigationView.PaneHeader>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Games" Tag="{x:Bind pages:GameGridPage.PageTag}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Library" Tag="{x:Bind pages:LibraryPage.PageTag}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Acknowledgements"
                                         Tag="{x:Bind pages:AcknowledgementsPage.PageTag}"
                                         Visibility="{x:Bind ViewModel.AcknowledgementsVisibility, Mode=OneWay}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>

        <Grid x:Name="LoadingStackPanel"
              Grid.Row="1"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <muxc:ProgressRing Grid.Row="0"
                               Width="42"
                               Height="42"
                               VerticalAlignment="Bottom"
                               IsActive="True"
                               IsIndeterminate="True" />
            <TextBlock Grid.Row="1"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
        </Grid>

        <InfoBar Grid.Row="1"
                 Margin="24"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                 IsOpen="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}"
                 Severity="Informational"
                 Title="{x:Bind ViewModel.TranslationProperties.UpdateAvailableBannerTitleText, Mode=OneWay}"
                 Message="{x:Bind ViewModel.UpdateAvailableText, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="{x:Bind ViewModel.TranslationProperties.UpdateText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.UpdateAvailableClickedCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
