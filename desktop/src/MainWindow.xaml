<Window
    x:Class="DLSS_Swapper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:pages="using:DLSS_Swapper.Pages"
    Title="XTR Unlocker"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" MinWidth="760" Background="{ThemeResource XtrBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Apple macOS Style Sleek Glass TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,16,0" Background="{ThemeResource XtrSidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Icon & Studio Title -->
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Image Width="22" Height="22" VerticalAlignment="Center" Source="Assets/icon_256.png" />
                <TextBlock VerticalAlignment="Center"
                           Text="XTR Unlocker"
                           FontSize="12.5"
                           FontFamily="{StaticResource XtrDisplayFontFamily}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource XtrTextBrush}" />
            </StackPanel>

            <!-- Apple Liquid Engine Status Pill -->
            <Border Grid.Column="2"
                    VerticalAlignment="Center"
                    Padding="10,3"
                    CornerRadius="10"
                    Background="{ThemeResource XtrElevatedBrush}"
                    BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource XtrSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="XTR ENGINE - FG READY"
                               FontSize="9.5"
                               FontWeight="Bold"
                               FontFamily="{StaticResource XtrDisplayFontFamily}"
                               CharacterSpacing="70"
                               Foreground="{ThemeResource XtrTextBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.ColumnSpan="3" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
        </Grid>

        <muxc:NavigationView x:Name="MainNavigationView"
                             Grid.Row="1"
                             PaneDisplayMode="Left"
                             IsPaneOpen="True"
                             IsPaneToggleButtonVisible="False"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="True"
                             OpenPaneLength="246"
                             CompactPaneLength="64"
                             SelectionFollowsFocus="Disabled"
                             ItemInvoked="MainNavigationView_ItemInvoked"
                             Loaded="MainNavigationView_Loaded"
                             Background="{ThemeResource XtrBackgroundBrush}">

            <muxc:NavigationView.PaneHeader>
                <Grid Padding="18,22,14,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="14" Background="{ThemeResource XtrElevatedBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1">
                        <Image Margin="8" Source="Assets/icon_256.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="XTR STUDIO" FontSize="14" FontWeight="Bold" CharacterSpacing="20" Foreground="{ThemeResource XtrTextBrush}" />
                        <TextBlock Text="NATIVE ENGINE 2.4" FontSize="9.5" CharacterSpacing="100" FontWeight="Bold" Foreground="{ThemeResource XtrAccentBrush}" />
                    </StackPanel>
                </Grid>
            </muxc:NavigationView.PaneHeader>

            <muxc:NavigationView.PaneFooter>
                <!-- Apple Liquid Engine Status Footer Card -->
                <Border Margin="14,0,14,16"
                        Padding="14,12"
                        CornerRadius="14"
                        Background="{ThemeResource XtrElevatedBrush}"
                        BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="9" Background="{ThemeResource XtrSurfaceBrush}" BorderBrush="{ThemeResource XtrGlassBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource XtrSuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Engine Online" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource XtrTextBrush}" />
                            <TextBlock Text="Hardware FG / FSR 3.1" FontSize="10" Foreground="{ThemeResource XtrSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </muxc:NavigationView.PaneFooter>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Game Library" Tag="{x:Bind pages:GameGridPage.PageTag}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Runtime DLLs" Tag="{x:Bind pages:LibraryPage.PageTag}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Acknowledgements"
                                         Tag="{x:Bind pages:AcknowledgementsPage.PageTag}"
                                         Visibility="{x:Bind ViewModel.AcknowledgementsVisibility, Mode=OneWay}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Background="{ThemeResource XtrBackgroundBrush}" />
        </muxc:NavigationView>

        <Grid x:Name="LoadingStackPanel"
              Grid.Row="1"
              Background="{ThemeResource XtrBackgroundBrush}"
              RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <muxc:ProgressRing Grid.Row="0"
                               Width="44"
                               Height="44"
                               VerticalAlignment="Bottom"
                               IsActive="True"
                               IsIndeterminate="True" />
            <TextBlock Grid.Row="1"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
        </Grid>

        <InfoBar Grid.Row="1"
                 Margin="24"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Background="{ThemeResource XtrElevatedBrush}"
                 BorderBrush="{ThemeResource XtrGlassBorderBrush}"
                 BorderThickness="1"
                 CornerRadius="16"
                 IsOpen="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}"
                 Severity="Informational"
                 Title="{x:Bind ViewModel.TranslationProperties.UpdateAvailableBannerTitleText, Mode=OneWay}"
                 Message="{x:Bind ViewModel.UpdateAvailableText, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="{x:Bind ViewModel.TranslationProperties.UpdateText, Mode=OneWay}"
                        Style="{StaticResource XtrPrimaryButtonStyle}"
                        Command="{x:Bind ViewModel.UpdateAvailableClickedCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
